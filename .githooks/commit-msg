#!/bin/sh
#
# ⚠️ THIS REPOSITORY IS AUTHORED BY skillLeo. NOBODY ELSE APPEARS ON A COMMIT.
#
# GitHub renders a Co-Authored-By trailer as "skillLeo and <name>" against every
# commit in the list, and this repository is shown to a client. The work is
# delivered under one name. That is not a stylistic preference — it is how the
# client understands who they are paying.
#
# This hook exists because the trailer was added ten times after being asked
# not to. A rule that depends on somebody remembering is not a rule.
#
# Install once:  git config core.hooksPath .githooks

# ⚠️ ANY co-author trailer, not a list of named tools.
#
# This used to enumerate specific tool names, which made the rule narrower than
# its own intent AND turned the guard into a list of the things it was guarding
# against. Rejecting the trailer outright is both stricter and quieter: this
# repository has one author, so there is no legitimate Co-Authored-By line.
if grep -qiE '^Co-authored-by:' "$1"; then
    echo "Commit blocked: a Co-Authored-By trailer is present." >&2
    echo "This repository is authored by skillLeo alone. Remove the trailer." >&2
    exit 1
fi

if grep -qiE '^[[:space:]]*(Generated with|Created with|Authored by) ' "$1"; then
    echo "Commit blocked: an attribution line is present." >&2
    echo "This repository is authored by skillLeo alone. Remove the line." >&2
    exit 1
fi

exit 0
